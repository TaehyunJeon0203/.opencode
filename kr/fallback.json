{
  "$schema": "https://raw.githubusercontent.com/HyeokjaeLee/opencode-auto-fallback/main/docs/fallback.schema.json",
  "enabled": true,
  "autoUpdate": false,
  "defaultFallback": ["opencode-go/deepseek-v4-flash", "openai/gpt-5.6-luna"],
  "defaultLargeContextModel": false,
  "defaultMinContextRatio": 0.1,
  "agents": {
    "orchestrator": {
      "fallback": ["openai/gpt-5.6-luna"]
    },
    "FE": {
      "fallback": [
        "opencode-go/kimi-k2.7-code",
        "opencode-go/deepseek-v4-pro"
      ]
    },
    "BE": {
      "fallback": ["openai/gpt-5.6-sol"]
    },
    "QA": {
      "fallback": [
        "opencode-go/deepseek-v4-flash",
        "openai/gpt-5.6-luna"
      ]
    },
    "PM": {
      "fallback": ["openai/gpt-5.6-luna"]
    },
    "figma-analyzer": {
      "fallback": ["openai/gpt-5.6-luna"]
    },
    "orchestrator-plus": {
      "fallback": ["opencode-go/gpt-5.6-luna"]
    }
  },
  "cooldownMs": 60000,
  "maxRetries": 2,
  "logging": true
}
